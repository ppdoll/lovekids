# ── 접근 방식은 둘 중 하나를 고릅니다 ──
#
# (A) 구글 로그인 (권장)
#     아래 두 개를 채우면 구글 로그인 모드로 동작합니다. 계정마다 데이터가 완전히 분리됩니다.
#     발급: Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹)
#     승인된 리디렉션 URI에 https://<내주소>/api/auth/callback 를 등록해야 합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 세션 쿠키 서명용 비밀값 (아무 긴 문자열). 비우면 GOOGLE_CLIENT_SECRET을 대신 씁니다.
# 이 값을 바꾸면 모두 다시 로그인해야 합니다.
SESSION_SECRET=

# 배포 주소 (구글 로그인에 필요). Vercel에서는 자동으로 잡히므로 보통 비워둡니다.
APP_URL=

# 이 사이트의 주인 계정 이메일.
# 구글 로그인을 붙이기 전에 쌓인 데이터는 "처음 로그인한 계정"이 이어받는데,
# 여기에 내 이메일을 적어두면 그 계정만 이어받을 수 있습니다.
# 남에게 사이트를 공개할 계획이라면 반드시 설정하세요.
OWNER_EMAIL=

# (B) 가족 코드 — 구글 로그인을 쓰지 않을 때만
#     GOOGLE_CLIENT_ID가 비어 있으면 이 코드로 접근을 막습니다(한 가정 전용).
FAMILY_CODE=

# (배포 시) Upstash Redis 저장소 — Vercel 마켓플레이스에서 Upstash 연동 시 자동 주입됩니다.
# 로컬에서는 비워두면 .data/store.json 파일에 저장됩니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
